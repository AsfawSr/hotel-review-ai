# Copy to .env and fill in. Used by `docker compose` and can be exported for `mvnw spring-boot:run`.

# --- Database (required) ---
DB_URL=jdbc:postgresql://localhost:5432/hotel_review_ai
DB_USERNAME=postgres
DB_PASSWORD=change-me

# --- Admin login (required) ---
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=change-me

# --- Profiles: add "rag" to enable pgvector retrieval over hotel policies (e.g. "dev,rag") ---
SPRING_PROFILES_ACTIVE=dev

# --- AI provider: "ollama" (local, default) or "openai" (any OpenAI-compatible API) ---
AI_CHAT_PROVIDER=ollama
AI_EMBEDDING_PROVIDER=ollama
AI_TEMPERATURE=0.2

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:latest
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# OpenAI-compatible (OpenAI, Groq, ...). Example for Groq:
#   OPENAI_BASE_URL=https://api.groq.com/openai  OPENAI_CHAT_MODEL=llama-3.1-8b-instant
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Must match the embedding model: 768 for nomic-embed-text, 1536 for text-embedding-3-small.
PGVECTOR_DIMENSIONS=768

# --- HTTP client timeouts for AI calls ---
HTTP_CONNECT_TIMEOUT=5s
HTTP_READ_TIMEOUT=120s

SERVER_PORT=8080
